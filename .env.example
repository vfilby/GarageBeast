# Copy to .env next to compose.yaml on the docker host. Never commit .env.
RTSP_URL=rtsps://<protect-console-ip>:7441/<rtsp-alias>?enableSrtp   # Protect camera > Advanced > RTSP (Low channel)
PROTECT_HOST=<protect-console-hostname>
PROTECT_USER=<local-unifi-os-account>
PROTECT_PASS=<password>
CAMERA_ID=<protect camera object id, 24 hex chars>
PJ_HOSTS=left-projector right-projector   # DNS names on the IoT VLAN (street view), space separated; read by projector/pjlink.py
PJ_PASSWORD=<projector web Admin password>   # same password PJLink uses; default was admin
